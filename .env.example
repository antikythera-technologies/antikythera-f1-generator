# ===========================================
# Antikythera F1 Video Generator Configuration
# ===========================================

# Application
APP_NAME=antikythera-f1-generator
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Database (PostgreSQL)
DATABASE_HOST=postgres.antikythera.co.za
DATABASE_PORT=5432
DATABASE_NAME=antikythera-f1-generator
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_URL=postgresql+asyncpg://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# MinIO Object Storage
MINIO_ENDPOINT=minio.antikythera.co.za:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true

# MinIO Buckets
MINIO_BUCKET_CHARACTERS=f1-characters
MINIO_BUCKET_SCENE_IMAGES=f1-scene-images
MINIO_BUCKET_VIDEO_CLIPS=f1-video-clips
MINIO_BUCKET_FINAL_VIDEOS=f1-final-videos

# Anthropic (Claude Haiku)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.8

# Gemini / Imagen (Image Generation)
# Get API key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-exp
GEMINI_IMAGE_RESOLUTION=1024x1536
GEMINI_STYLE_REFERENCE_COUNT=4

# Video Engine Selection
# "ovi" = Ovi Gradio (HuggingFace), "ltx2" = LTX-2 via ComfyUI on RunPod
VIDEO_ENGINE=ovi

# Ovi (HuggingFace Gradio) - Video Generation
# Get HuggingFace token from: https://huggingface.co/settings/tokens
# Token is REQUIRED for reliable access to Ovi ZEROGPU space
OVI_SPACE=alexnasa/Ovi-ZEROGPU
OVI_TIMEOUT_SECONDS=300
OVI_QUALITY=caricature  # draft, standard, high, ultra, caricature (recommended)
HUGGINGFACE_TOKEN=

# Ovi Style Preservation (override preset defaults)
# Higher conditioning + lower denoise = better style preservation
OVI_IMAGE_CONDITIONING_STRENGTH=0.85  # 0.0-1.0, higher = more source fidelity
OVI_DENOISE_STRENGTH=0.55             # 0.0-1.0, lower = less re-interpretation
OVI_GUIDANCE_SCALE=2.0                # lower = less hallucination

# RunPod / ComfyUI (for LTX-2 video generation)
RUNPOD_POD_ID=tims42v3eaqrz7
COMFYUI_PORT=19123
COMFYUI_TIMEOUT_SECONDS=600

# LTX-2 Video Generation (via ComfyUI)
LTX2_DENOISE_STRENGTH=0.45    # 0.0-1.0, lower = preserve more of source
LTX2_CONDITIONING_SCALE=0.90  # 0.0-1.0, higher = more faithful to source
LTX2_GUIDANCE_SCALE=3.0       # balance prompt vs image fidelity
LTX2_STEPS=20                 # fewer = less deviation
LTX2_FRAME_COUNT=121          # ~5s at 24fps
LTX2_WIDTH=768
LTX2_HEIGHT=512
LTX2_FPS=24
LTX2_SEED=-1                  # -1 = random

# YouTube API
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_CREDENTIALS_PATH=~/.credentials/antikythera-f1/youtube_credentials.json

# Redis (optional - for job queue)
REDIS_URL=redis://localhost:6379/0

# Video Generation Settings
VIDEO_SCENE_COUNT=24
VIDEO_SCENE_DURATION_SECONDS=5
VIDEO_TOTAL_DURATION_SECONDS=120
VIDEO_FRAME_RATE=24
VIDEO_RESOLUTION=1080p
VIDEO_CODEC=libx264
VIDEO_AUDIO_CODEC=aac
VIDEO_CRF=23

# Retry Configuration
RETRY_MAX_ATTEMPTS=3
RETRY_BASE_DELAY_SECONDS=5
RETRY_MAX_DELAY_SECONDS=300

# Storage Retention
STORAGE_RETENTION_RACES=3

# Scheduling
TRIGGER_CHECK_INTERVAL_MINUTES=15
PRE_RACE_DELAY_MINUTES=30
POST_RACE_DELAY_MINUTES=60
